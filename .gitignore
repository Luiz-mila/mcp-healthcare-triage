# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# --- Environment variables (local secrets) ---
.env

# --- Data (never commit patient data, even synthetic) ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- Local databases ---
*.duckdb
*.db

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store

# --- Docker ---
*.log

# --- Manual scratch scripts (ad-hoc debugging, not part of the test suite) ---
tests/manual_*.py